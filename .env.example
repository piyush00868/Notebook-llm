# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.
PORT=
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
MISTRAL_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
GROQ_API_KEY=
GROQ_MODEL=
# --- YouTube ingestion ---
# Public API key. Used for caption *metadata* only (captions.list).
# YOUTUBE_API_KEY=
# OAuth client from Google Cloud Console > APIs & Services > Credentials.
# The callback route must be registered as an authorised redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/auth/youtube/callback
# Where the browser is returned after consenting. Used by the OAuth callback.
# FRONTEND_URL=http://localhost:5173
